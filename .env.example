# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/marches?schema=public"

# ── Better Auth ───────────────────────────────────────────────────────────────
# Required: 32+ character random string
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Comma-separated hostnames allowed for dynamic baseURL resolution (Better Auth 1.5+)
# Include all domains and host:port combos your app is served from
ALLOWED_HOSTS="localhost:5173,localhost:5174,www.example.com,admin.example.com"

# Canonical public URL — used for email verification links
SITE_URL="https://www.example.com"

# Comma-separated origins for Better Auth CSRF validation
TRUSTED_ORIGINS="http://localhost:5173,http://localhost:5174"

# ── Ports ─────────────────────────────────────────────────────────────────────
# Override default ports (defaults: 5173 frontend, 5174 admin)
FRONTEND_PORT=5173
ADMIN_PORT=5174

# ── Body size ─────────────────────────────────────────────────────────────────
# Increase for large data imports (adapter-node default is 512KB)
BODY_SIZE_LIMIT=10M

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Marches <noreply@example.com>"

# ── Discord Bot ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-application-client-id"

# ── Seeding ───────────────────────────────────────────────────────────────────
# Password for the initial superadmin account created by the seed script
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_EMAIL="admin@example.com"
