/* shared/database/prisma/gamesystem.prisma */

// How a character earns levels. Both modes resolve level the same way:
// count the thresholds cleared by the character's running total.
enum ProgressionMode {
  XP        // levels derived from ProgressionThreshold.xpRequired vs Character.totalXp
  MILESTONE // levels derived from ProgressionThreshold.milestoneRequired vs Character.totalMilestones

  @@schema("gamesystem")
}

model GameSystem {
  id          String          @id @default(uuid())
  name        String          @unique
  slug        String          @unique
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  // Default for new characters — a World may override, and the character snapshots the result.
  defaultProgressionMode ProgressionMode @default(XP) @map("default_progression_mode")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt      @map("updated_at")

  progressionThresholds ProgressionThreshold[]

  @@map("game_systems")
  @@schema("gamesystem")
}

model ProgressionThreshold {
  id           String     @id @default(uuid())
  gameSystemId String     @map("game_system_id")
  gameSystem   GameSystem @relation(fields: [gameSystemId], references: [id], onDelete: Cascade)
  label        String
  xpRequired   Int        @map("xp_required")
  // Milestone credits required for this level. Only read in MILESTONE mode.
  milestoneRequired Int   @default(0) @map("milestone_required")
  description  String?
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt      @map("updated_at")

  @@map("progression_thresholds")
  @@schema("gamesystem")
}
