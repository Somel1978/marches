/* shared/database/prisma/gamesystem.prisma */

model GameSystem {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  progressionThresholds ProgressionThreshold[]

  @@map("game_systems")
  @@schema("gamesystem")
}

model ProgressionThreshold {
  id           String     @id @default(uuid())
  gameSystemId String     @map("game_system_id")
  gameSystem   GameSystem @relation(fields: [gameSystemId], references: [id], onDelete: Cascade)
  label        String
  xpRequired   Int        @map("xp_required")
  description  String?
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt      @map("updated_at")

  @@map("progression_thresholds")
  @@schema("gamesystem")
}
