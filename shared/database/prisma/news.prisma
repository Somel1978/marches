/* shared/database/prisma/news.prisma */

enum AnnouncementType {
  NEWS
  EVENT
  WARNING
  STATUS

  @@schema("news")
}

model Announcement {
  id          String           @id @default(uuid())
  title       String
  content     String
  type        AnnouncementType @default(NEWS)
  tags        String[]
  scheduledAt DateTime?        @map("scheduled_at")
  expiresAt   DateTime?        @map("expires_at")
  isPublished Boolean          @default(false) @map("is_published")
  publishedAt DateTime?        @map("published_at")
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt      @map("updated_at")

  @@map("announcements")
  @@schema("news")
}

model Journal {
  id          String           @id @default(uuid())
  title       String
  icon        String?
  description String?
  sortOrder   Int              @default(0) @map("sort_order")
  isPublished Boolean          @default(false) @map("is_published")
  worldIds    String[]         @map("world_ids")
  roleIds     String[]         @map("role_ids")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt      @map("updated_at")

  sections    JournalSection[]

  @@map("journals")
  @@schema("news")
}

model JournalSection {
  id        String        @id @default(uuid())
  journalId String        @map("journal_id")
  journal   Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  title     String
  icon      String?
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt      @map("updated_at")

  pages     JournalPage[]

  @@map("journal_sections")
  @@schema("news")
}

model JournalPage {
  id        String         @id @default(uuid())
  sectionId String         @map("section_id")
  section   JournalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  content   String         @default("")
  sortOrder Int            @default(0) @map("sort_order")
  createdBy String         @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt      @map("updated_at")

  @@map("journal_pages")
  @@schema("news")
}
