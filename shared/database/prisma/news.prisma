/* shared/database/prisma/news.prisma */

enum AnnouncementType {
  NEWS
  EVENT
  WARNING
  STATUS

  @@schema("news")
}

enum ContentVisibility {
  PUBLIC      // all logged-in users
  WORLD       // characters in that world only (WorldJournal only)
  DM_ONLY     // users with an active DMProfile
  ADMIN_ONLY  // users with admin permission (includes SUPERADMIN)

  @@schema("news")
}

model Announcement {
  id          String           @id @default(uuid())
  title       String
  content     String
  type        AnnouncementType @default(NEWS)
  tags        String[]
  scheduledAt DateTime?        @map("scheduled_at")
  expiresAt   DateTime?        @map("expires_at")
  isPublished Boolean          @default(false) @map("is_published")
  publishedAt DateTime?        @map("published_at")
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt      @map("updated_at")

  @@map("announcements")
  @@schema("news")
}

// ── World Journal ─────────────────────────────────────────────────────────────
// Lore and content scoped to a specific world.
// Written by DMs (via DM hub) and admins (via admin world route).

model WorldJournal {
  id          String            @id @default(uuid())
  worldId     String            @map("world_id")
  world       World             @relation(fields: [worldId], references: [id], onDelete: Cascade)
  title       String
  icon        String?
  description String?
  sortOrder   Int               @default(0)     @map("sort_order")
  isPublished Boolean           @default(false) @map("is_published")
  visibility  ContentVisibility @default(PUBLIC)
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt      @map("updated_at")

  sections    WorldJournalSection[]

  @@map("world_journals")
  @@schema("news")
}

model WorldJournalSection {
  id         String            @id @default(uuid())
  journalId  String            @map("journal_id")
  journal    WorldJournal      @relation(fields: [journalId], references: [id], onDelete: Cascade)
  title      String
  icon       String?
  sortOrder  Int               @default(0) @map("sort_order")
  visibility ContentVisibility @default(PUBLIC)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt      @map("updated_at")

  pages      WorldJournalPage[]

  @@map("world_journal_sections")
  @@schema("news")
}

model WorldJournalPage {
  id        String              @id @default(uuid())
  sectionId String              @map("section_id")
  section   WorldJournalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  content   String              @default("")
  sortOrder Int                 @default(0) @map("sort_order")
  createdBy String              @map("created_by")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt      @map("updated_at")

  @@map("world_journal_pages")
  @@schema("news")
}

// ── Platform Wiki ─────────────────────────────────────────────────────────────
// Global knowledge base written by admins.
// Visible to all players by default; sections/entries can be gated.

model PlatformWiki {
  id          String            @id @default(uuid())
  title       String
  icon        String?
  description String?
  sortOrder   Int               @default(0)     @map("sort_order")
  isPublished Boolean           @default(false) @map("is_published")
  visibility  ContentVisibility @default(PUBLIC)
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt      @map("updated_at")

  sections    PlatformWikiSection[]

  @@map("platform_wikis")
  @@schema("news")
}

model PlatformWikiSection {
  id         String            @id @default(uuid())
  wikiId     String                @map("wiki_id")
  wiki       PlatformWiki       @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  title      String
  icon       String?
  sortOrder  Int               @default(0) @map("sort_order")
  visibility ContentVisibility @default(PUBLIC)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt      @map("updated_at")

  pages      PlatformWikiPage[]

  @@map("platform_wiki_sections")
  @@schema("news")
}

model PlatformWikiPage {
  id        String      @id @default(uuid())
  sectionId String      @map("section_id")
  section   PlatformWikiSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  content   String      @default("")
  sortOrder Int         @default(0) @map("sort_order")
  createdBy String      @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt      @map("updated_at")

  @@map("platform_wiki_pages")
  @@schema("news")
}
