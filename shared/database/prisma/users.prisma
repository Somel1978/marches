// ─── Domain Models ────────────────────────────────────────────────────────────
// All models live in the "users" Postgres schema.
// ─────────────────────────────────────────────────────────────────────────────

enum AccessLevel {
  NONE
  OWN
  ALL

  @@schema("users")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?

  // Domain fields — also declared as additionalFields in @core/rbac createAuth()
  // so better-auth is aware of them. input: false means they are not settable
  // during signup; they must be updated via a profile endpoint.
  discordHandle String?  @map("discord_handle")
  mobile        String?

  // NOTE: no password field here. better-auth stores the hashed password in
  // Account.password (see auth.prisma). Having a password on User would create
  // two sources of truth and cause confusion.

  // better-auth relations
  sessions      Session[]
  accounts      Account[]

  // RBAC — explicit join table (UserRole) instead of implicit M2M.
  // Implicit M2M with multiSchema has ambiguous join-table schema placement.
  // Explicit gives us control over schema, indices, and audit fields.
  userRoles     UserRole[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")

  @@map("users")
  @@schema("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("roles")
  @@schema("users")
}

// Explicit join table for User <-> Role.
// Replaces the implicit M2M Prisma would have generated.
// Explicit gives us:
//   - guaranteed @@schema("users") placement
//   - assignedAt / assignedBy audit trail
model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("users")
}

model RolePermission {
  id        String      @id @default(uuid())
  roleId    String      @map("role_id")
  role      Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  resource  String

  canCreate AccessLevel @default(NONE) @map("can_create")
  canRead   AccessLevel @default(NONE) @map("can_read")
  canUpdate AccessLevel @default(NONE) @map("can_update")
  canDelete AccessLevel @default(NONE) @map("can_delete")

  @@unique([roleId, resource])
  @@map("role_permissions")
  @@schema("users")
}
