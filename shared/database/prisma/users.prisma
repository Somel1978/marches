/* shared/database/prisma/users.prisma */

// ── Domain Models (schema: users, order: 02) ─────────────────────────────────
// Cross-schema FK: RolePermission.resourceKey → platform.Resource.key
// auth schema models live in auth.prisma.
// ─────────────────────────────────────────────────────────────────────────────

enum AccessLevel {
  NONE
  OWN
  ALL

  @@schema("users")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?

  discordHandle String?  @map("discord_handle")
  mobile        String?

  sessions      Session[]
  accounts      Account[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")
  createdBy     String?  @map("created_by")
  updatedBy     String?  @map("updated_by")

  @@map("users")
  @@schema("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("roles")
  @@schema("users")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("users")
}

model RolePermission {
  id          String   @id @default(uuid())
  roleId      String   @map("role_id")
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Cross-schema FK → platform.Resource.key
  // DB enforces referential integrity — invalid keys are rejected.
  // Application layer (dbapi) also validates before writing for cleaner errors.
  resourceKey String   @map("resource_key")
  resource    Resource @relation(fields: [resourceKey], references: [key], onDelete: Cascade)

  canCreate   AccessLevel @default(NONE) @map("can_create")
  canRead     AccessLevel @default(NONE) @map("can_read")
  canUpdate   AccessLevel @default(NONE) @map("can_update")
  canDelete   AccessLevel @default(NONE) @map("can_delete")

  @@unique([roleId, resourceKey])
  @@map("role_permissions")
  @@schema("users")
}
