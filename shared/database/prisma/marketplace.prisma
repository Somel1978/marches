/* shared/database/prisma/marketplace.prisma */

// ── Marketplace (schema: marketplace, order: 09) ─────────────────────────────

enum ItemCategory {
  Combat
  Consumable
  Utility
  Destroyable

  @@schema("marketplace")
}

enum ItemRarity {
  Mundane
  Common
  Uncommon
  Rare
  Very_Rare
  Legendary
  Artifact
  Unknown

  @@schema("marketplace")
}

enum MarketTransactionType {
  BUY
  SELL
  REWARD

  @@schema("marketplace")
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("marketplace")
}

model MarketplaceItem {
  id                 String       @id @default(uuid())
  name               String       @unique
  category           ItemCategory
  baseItem           String       @map("base_item")
  isVariant          Boolean      @default(false) @map("is_variant")
  rarity             ItemRarity   @default(Mundane)
  requiresAttunement Boolean      @default(false) @map("requires_attunement")
  requirements       String?
  weight             Float?
  source             String?
  imageUrl           String?      @map("image_url")
  link               String?
  description        String?
  buyPrice           Float        @default(0) @map("buy_price")
  isDestroyable      Boolean      @default(false) @map("is_destroyable")
  isAvailable        Boolean      @default(true)  @map("is_available")
  stock              Int?         // null = unlimited
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt      @map("updated_at")

  transactions       MarketplaceTransaction[]
  worldOverrides     WorldMarketplaceItem[]

  @@map("marketplace_items")
  @@schema("marketplace")
}

model MarketplaceTransaction {
  id                   String            @id @default(uuid())
  itemId               String            @map("item_id")
  item                 MarketplaceItem   @relation(fields: [itemId], references: [id])
  characterId          String            @map("character_id")
  type                 MarketTransactionType
  status               TransactionStatus @default(PENDING)
  quantity             Int               @default(1)
  priceAtTransaction   Float             @map("price_at_transaction")  // snapshot
  totalPrice           Float             @map("total_price")           // quantity * price
  requestedBy          String            @map("requested_by")          // userId
  reviewedBy           String?           @map("reviewed_by")
  reviewNote           String?           @map("review_note")
  worldId              String?           @map("world_id")  // null = global
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt      @map("updated_at")

  @@map("marketplace_transactions")
  @@schema("marketplace")
}

model WorldMarketplaceItem {
  id            String          @id @default(uuid())
  worldId       String          @map("world_id")
  itemId        String          @map("item_id")
  item          MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stock         Int?            // null = inherit global stock behaviour
  isAvailable   Boolean?        @map("is_available")   // null = inherit global
  priceOverride Float?          @map("price_override") // null = use global buyPrice
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt      @map("updated_at")

  @@unique([worldId, itemId])
  @@map("world_marketplace_items")
  @@schema("marketplace")
}

model WorldMarketplaceSetting {
  id                  String   @id @default(uuid())
  worldId             String   @unique @map("world_id")
  sellPricePercent    Int?     @map("sell_price_percent") // null = use global
  stockEnabled        Boolean? @map("stock_enabled")      // null = use global
  levelRestrictions   Json?    @map("level_restrictions") // null = use global
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  @@map("world_marketplace_settings")
  @@schema("marketplace")
}
