/* shared/database/prisma/dms.prisma */

// ── DM Hub (schema: dms, order: 07) ─────────────────────────────────────────

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("dms")
}

model DMProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  bio         String?
  specialties String?
  rules       String?  // DM rules — pre-populates quest rules on creation
  isPublic    Boolean  @default(true)  @map("is_public")
  isActive    Boolean  @default(true)  @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  preferredSystems DMGameSystem[]

  @@map("dm_profiles")
  @@schema("dms")
}

model DMGameSystem {
  id           String    @id @default(uuid())
  dmProfileId  String    @map("dm_profile_id")
  dmProfile    DMProfile @relation(fields: [dmProfileId], references: [id], onDelete: Cascade)
  gameSystemId String    @map("game_system_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([dmProfileId, gameSystemId])
  @@map("dm_game_systems")
  @@schema("dms")
}

model RoleRequest {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  roleId      String            @map("role_id")
  reason      String
  status      RoleRequestStatus @default(PENDING)
  reviewedBy  String?           @map("reviewed_by")
  reviewNote  String?           @map("review_note")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt      @map("updated_at")

  @@map("role_requests")
  @@schema("dms")
}

model DMRating {
  id          String    @id @default(uuid())
  dmProfileId String    @map("dm_profile_id")
  userId      String    @map("user_id")
  questId     String    @map("quest_id")
  rating      Int       // 1-5
  comment     String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([dmProfileId, questId, userId])
  @@map("dm_ratings")
  @@schema("dms")
}
