/* shared/database/prisma/world.prisma */

// ── World System (schema: world, order: 10) ──────────────────────────────────

enum DangerRating {
  Safe        // 1
  Low         // 2
  Moderate    // 3
  High        // 4
  Extreme     // 5

  @@schema("world")
}

enum LocationType {
  Town
  City
  Dungeon
  Ruins
  Landmark
  Wilderness
  Other

  @@schema("world")
}

enum WikiEntityType {
  WORLD
  REGION
  LOCATION

  @@schema("world")
}

enum NeuralEntityType {
  REGION
  LOCATION
  FACTION
  NPC
  QUEST
  CHARACTER
  JOURNAL

  @@schema("world")
}

model World {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  mapImageUrl  String?  @map("map_image_url")
  isActive              Boolean  @default(true)  @map("is_active")
  acceptsGlobalCharacters Boolean  @default(true)  @map("accepts_global_characters")
  // null = inherit GameSystem.defaultProgressionMode
  progressionMode ProgressionMode? @map("progression_mode")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  regions      Region[]
  dms          WorldDM[]
  journals     WorldJournal[]
  tavernChannel TavernChannel?
  factions     Faction[]
  npcs         Npc[]
  // Sparse diffs on top of GameSystem ProgressionThreshold rows.
  progressionOverrides WorldProgressionOverride[]
  neuralNodes  NeuralMapNode[]
  neuralEdges  NeuralMapEdge[]

  @@map("worlds")
  @@schema("world")
}

// Sparse world ladder override. null column = inherit the system threshold value.
// A row with both override columns null must not be stored — delete instead.
model WorldProgressionOverride {
  id                String   @id @default(uuid())
  worldId           String   @map("world_id")
  world             World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  // ProgressionThreshold.id (cross-schema; resolved at app level)
  thresholdId       String   @map("threshold_id")
  xpRequired        Int?     @map("xp_required")
  milestoneRequired Int?     @map("milestone_required")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([worldId, thresholdId])
  @@map("world_progression_overrides")
  @@schema("world")
}

model Region {
  id           String       @id @default(uuid())
  worldId      String       @map("world_id")
  world        World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name         String
  slug         String       @map("slug")
  description  String?
  mapX         Float?       @map("map_x")   // % position on world map (0-100)
  mapY         Float?       @map("map_y")   // % position on world map (0-100)
  color        String       @default("#6366f1") // marker + overlay color
  minLevel     Int?         @map("min_level")
  maxLevel     Int?         @map("max_level")
  dangerRating DangerRating @default(Safe) @map("danger_rating")
  isActive     Boolean      @default(true)  @map("is_active")
  imageUrl     String?      @map("image_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt      @map("updated_at")

  dms          RegionDM[]
  locations    Location[]

  @@unique([worldId, slug])
  @@map("regions")
  @@schema("world")
}

model RegionDM {
  id          String   @id @default(uuid())
  regionId    String   @map("region_id")
  region      Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  dmProfileId String   @map("dm_profile_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  String   @map("assigned_by")

  @@unique([regionId, dmProfileId])
  @@map("region_dms")
  @@schema("world")
}

model Location {
  id           String       @id @default(uuid())
  regionId     String       @map("region_id")
  region       Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name         String
  slug         String       @map("slug")
  description  String?
  type         LocationType @default(Other)
  minLevel     Int?         @map("min_level")
  maxLevel     Int?         @map("max_level")
  dangerRating DangerRating @default(Safe)  @map("danger_rating")
  isActive     Boolean      @default(true)  @map("is_active")
  imageUrl     String?      @map("image_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt      @map("updated_at")

  @@unique([regionId, slug])
  @@map("locations")
  @@schema("world")
}

model WikiPage {
  id          String         @id @default(uuid())
  entityType  WikiEntityType @map("entity_type")
  entityId    String         @map("entity_id")
  title       String
  content     String         // markdown
  editedBy    String         @map("edited_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")

  revisions   WikiRevision[]

  @@unique([entityType, entityId])
  @@map("wiki_pages")
  @@schema("world")
}

model WikiRevision {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   String
  editedBy  String   @map("edited_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("wiki_revisions")
  @@schema("world")
}

model WorldDM {
  id          String   @id @default(uuid())
  worldId     String   @map("world_id")
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  dmProfileId String   @map("dm_profile_id")
  canManage   Boolean  @default(false) @map("can_manage")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  String   @map("assigned_by")

  @@unique([worldId, dmProfileId])
  @@map("world_dms")
  @@schema("world")
}

// DM-authored lore board: place world entities and draw plot connections.
// Entity refs are soft IDs (cross-schema); hydrate names at read time.
model NeuralMapNode {
  id         String           @id @default(uuid())
  worldId    String           @map("world_id")
  world      World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  entityType NeuralEntityType @map("entity_type")
  entityId   String           @map("entity_id")
  // Normalized canvas coords (0–1000 space)
  posX       Float            @default(500) @map("pos_x")
  posY       Float            @default(500) @map("pos_y")
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt      @map("updated_at")

  edgesFrom  NeuralMapEdge[]  @relation("NeuralEdgeFrom")
  edgesTo    NeuralMapEdge[]  @relation("NeuralEdgeTo")

  @@unique([worldId, entityType, entityId])
  @@index([worldId])
  @@map("neural_map_nodes")
  @@schema("world")
}

model NeuralMapEdge {
  id         String        @id @default(uuid())
  worldId    String        @map("world_id")
  world      World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  fromNodeId String        @map("from_node_id")
  fromNode   NeuralMapNode @relation("NeuralEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String        @map("to_node_id")
  toNode     NeuralMapNode @relation("NeuralEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  label      String?
  notes      String?
  directed   Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt      @map("updated_at")

  @@index([worldId])
  @@map("neural_map_edges")
  @@schema("world")
}
