/* shared/database/prisma/world.prisma */

// ── World System (schema: world, order: 10) ──────────────────────────────────

enum DangerRating {
  Safe        // 1
  Low         // 2
  Moderate    // 3
  High        // 4
  Extreme     // 5

  @@schema("world")
}

enum LocationType {
  Town
  City
  Dungeon
  Ruins
  Landmark
  Wilderness
  Other

  @@schema("world")
}

enum WikiEntityType {
  WORLD
  REGION
  LOCATION

  @@schema("world")
}

enum NeuralEntityType {
  REGION
  LOCATION
  FACTION
  NPC
  QUEST
  CHARACTER
  JOURNAL
  PLOT_QUEST

  @@schema("world")
}

enum PlotQuestStatus {
  DRAFT
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED

  @@schema("world")
}

model World {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  mapImageUrl  String?  @map("map_image_url")
  isActive              Boolean  @default(true)  @map("is_active")
  acceptsGlobalCharacters Boolean  @default(true)  @map("accepts_global_characters")
  // null = inherit GameSystem.defaultProgressionMode
  progressionMode ProgressionMode? @map("progression_mode")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  regions      Region[]
  dms          WorldDM[]
  journals     WorldJournal[]
  tavernChannel TavernChannel?
  factions     Faction[]
  npcs         Npc[]
  // Sparse diffs on top of GameSystem ProgressionThreshold rows.
  progressionOverrides WorldProgressionOverride[]
  neuralNodes  NeuralMapNode[]
  neuralEdges  NeuralMapEdge[]
  plotQuests   PlotQuest[]
  calendar     WorldCalendar?
  timelineEvents TimelineEvent[]
  regionWeather  RegionWeather[]
  npcSchedules   NpcSchedule[]

  @@map("worlds")
  @@schema("world")
}

// ── World calendar / timeline ────────────────────────────────────────────────

enum CalendarEraDirection {
  FORWARD
  BACKWARD

  @@schema("world")
}

enum TimelineViewKind {
  LIST
  CALENDAR
  GANTT

  @@schema("world")
}

enum WeatherCondition {
  CLEAR
  CLOUDY
  RAIN
  STORM
  SNOW
  FOG
  HEAT
  COLD
  OTHER

  @@schema("world")
}

enum TimelineEventType {
  WAR
  FESTIVAL
  DISASTER
  POLITICAL
  OTHER

  @@schema("world")
}

enum TimelineVisibility {
  PUBLIC
  DM_ONLY

  @@schema("world")
}

enum CalendarTimeFormat {
  H24
  H12

  @@schema("world")
}

/** One calendar definition per world. Dates use absoluteDay (days since epoch day 0). */
model WorldCalendar {
  id                     String            @id @default(uuid())
  worldId                String            @unique @map("world_id")
  world                  World             @relation(fields: [worldId], references: [id], onDelete: Cascade)
  hoursPerDay            Int               @default(24) @map("hours_per_day")
  minutesPerHour         Int               @default(60) @map("minutes_per_hour")
  epochWeekdayIndex      Int               @default(0) @map("epoch_weekday_index")
  weekdaysResetEachMonth Boolean           @default(false) @map("weekdays_reset_each_month")
  erasStartOnZero        Boolean           @default(false) @map("eras_start_on_zero")
  dateFormat             String            @default("MMMM D^, YYYY E") @map("date_format")
  timeFormat             CalendarTimeFormat @default(H24) @map("time_format")
  enableListView         Boolean           @default(true) @map("enable_list_view")
  enableCalendarView     Boolean           @default(true) @map("enable_calendar_view")
  enableGanttView        Boolean           @default(false) @map("enable_gantt_view")
  defaultView            TimelineViewKind  @default(LIST) @map("default_view")
  /// World “today” as absolute day (timeline / clock).
  currentDay             Int               @default(0) @map("current_day")
  timelineStartDay       Int?              @map("timeline_start_day")
  timelineEndDay         Int?              @map("timeline_end_day")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  months   WorldCalendarMonth[]
  weekdays WorldCalendarWeekday[]
  eras     WorldCalendarEra[]
  moons    WorldCalendarMoon[]

  @@map("world_calendars")
  @@schema("world")
}

model WorldCalendarMonth {
  id           String        @id @default(uuid())
  calendarId   String        @map("calendar_id")
  calendar     WorldCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String?
  dayCount     Int           @map("day_count")
  sortOrder    Int           @default(0) @map("sort_order")

  @@index([calendarId])
  @@map("world_calendar_months")
  @@schema("world")
}

model WorldCalendarWeekday {
  id           String        @id @default(uuid())
  calendarId   String        @map("calendar_id")
  calendar     WorldCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String?
  sortOrder    Int           @default(0) @map("sort_order")

  @@index([calendarId])
  @@map("world_calendar_weekdays")
  @@schema("world")
}

model WorldCalendarEra {
  id           String               @id @default(uuid())
  calendarId   String               @map("calendar_id")
  calendar     WorldCalendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String
  direction    CalendarEraDirection @default(FORWARD)
  startDay     Int                  @default(0) @map("start_day")
  sortOrder    Int                  @default(0) @map("sort_order")

  @@index([calendarId])
  @@map("world_calendar_eras")
  @@schema("world")
}

model WorldCalendarMoon {
  id               String        @id @default(uuid())
  calendarId       String        @map("calendar_id")
  calendar         WorldCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  name             String
  cycleLengthDays  Float         @map("cycle_length_days")
  offsetDays       Float         @default(0) @map("offset_days")
  sortOrder        Int           @default(0) @map("sort_order")

  @@index([calendarId])
  @@map("world_calendar_moons")
  @@schema("world")
}

model TimelineEvent {
  id          String             @id @default(uuid())
  worldId     String             @map("world_id")
  world       World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  description String?
  eventType   TimelineEventType  @default(OTHER) @map("event_type")
  startDay    Int                @map("start_day")
  endDay      Int?               @map("end_day")
  startMinute Int?               @map("start_minute")
  endMinute   Int?               @map("end_minute")
  visibility  TimelineVisibility @default(PUBLIC)
  // Soft IDs (same-schema but optional; not FK to keep editor flexible)
  regionId    String?            @map("region_id")
  factionId   String?            @map("faction_id")
  createdBy   String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([worldId, startDay])
  @@map("timeline_events")
  @@schema("world")
}

/** Region weather overlay on the world timeline (Phase 2). */
model RegionWeather {
  id          String             @id @default(uuid())
  worldId     String             @map("world_id")
  world       World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  // Soft Region.id
  regionId    String             @map("region_id")
  condition   WeatherCondition   @default(CLEAR)
  title       String?
  summary     String?
  startDay    Int                @map("start_day")
  endDay      Int?               @map("end_day")
  visibility  TimelineVisibility @default(PUBLIC)
  createdBy   String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([worldId, startDay])
  @@index([regionId])
  @@map("region_weather")
  @@schema("world")
}

/** NPC schedule blocks on the world timeline (Phase 2). */
model NpcSchedule {
  id           String             @id @default(uuid())
  worldId      String             @map("world_id")
  world        World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  // Soft Npc.id
  npcId        String             @map("npc_id")
  title        String
  summary      String?
  locationNote String?            @map("location_note")
  startDay     Int                @map("start_day")
  endDay       Int?               @map("end_day")
  startMinute  Int?               @map("start_minute")
  endMinute    Int?               @map("end_minute")
  visibility   TimelineVisibility @default(PUBLIC)
  createdBy    String             @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([worldId, startDay])
  @@index([npcId])
  @@map("npc_schedules")
  @@schema("world")
}

// Sparse world ladder override. null column = inherit the system threshold value.
// A row with both override columns null must not be stored — delete instead.
model WorldProgressionOverride {
  id                String   @id @default(uuid())
  worldId           String   @map("world_id")
  world             World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  // ProgressionThreshold.id (cross-schema; resolved at app level)
  thresholdId       String   @map("threshold_id")
  xpRequired        Int?     @map("xp_required")
  milestoneRequired Int?     @map("milestone_required")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([worldId, thresholdId])
  @@map("world_progression_overrides")
  @@schema("world")
}

model Region {
  id           String       @id @default(uuid())
  worldId      String       @map("world_id")
  world        World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name         String
  slug         String       @map("slug")
  description  String?
  mapX         Float?       @map("map_x")   // % position on world map (0-100)
  mapY         Float?       @map("map_y")   // % position on world map (0-100)
  color        String       @default("#6366f1") // marker + overlay color
  minLevel     Int?         @map("min_level")
  maxLevel     Int?         @map("max_level")
  dangerRating DangerRating @default(Safe) @map("danger_rating")
  isActive     Boolean      @default(true)  @map("is_active")
  imageUrl     String?      @map("image_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt      @map("updated_at")

  dms          RegionDM[]
  locations    Location[]

  @@unique([worldId, slug])
  @@map("regions")
  @@schema("world")
}

model RegionDM {
  id          String   @id @default(uuid())
  regionId    String   @map("region_id")
  region      Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  dmProfileId String   @map("dm_profile_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  String   @map("assigned_by")

  @@unique([regionId, dmProfileId])
  @@map("region_dms")
  @@schema("world")
}

model Location {
  id           String       @id @default(uuid())
  regionId     String       @map("region_id")
  region       Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name         String
  slug         String       @map("slug")
  description  String?
  type         LocationType @default(Other)
  minLevel     Int?         @map("min_level")
  maxLevel     Int?         @map("max_level")
  dangerRating DangerRating @default(Safe)  @map("danger_rating")
  isActive     Boolean      @default(true)  @map("is_active")
  imageUrl     String?      @map("image_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt      @map("updated_at")

  @@unique([regionId, slug])
  @@map("locations")
  @@schema("world")
}

model WikiPage {
  id          String         @id @default(uuid())
  entityType  WikiEntityType @map("entity_type")
  entityId    String         @map("entity_id")
  title       String
  content     String         // markdown
  editedBy    String         @map("edited_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")

  revisions   WikiRevision[]

  @@unique([entityType, entityId])
  @@map("wiki_pages")
  @@schema("world")
}

model WikiRevision {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   String
  editedBy  String   @map("edited_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("wiki_revisions")
  @@schema("world")
}

model WorldDM {
  id          String   @id @default(uuid())
  worldId     String   @map("world_id")
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  dmProfileId String   @map("dm_profile_id")
  canManage   Boolean  @default(false) @map("can_manage")
  assignedAt  DateTime @default(now()) @map("assigned_at")
  assignedBy  String   @map("assigned_by")

  @@unique([worldId, dmProfileId])
  @@map("world_dms")
  @@schema("world")
}

// DM-authored lore board: place world entities and draw plot connections.
// Entity refs are soft IDs (cross-schema); hydrate names at read time.
model NeuralMapNode {
  id         String           @id @default(uuid())
  worldId    String           @map("world_id")
  world      World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  entityType NeuralEntityType @map("entity_type")
  entityId   String           @map("entity_id")
  // Normalized canvas coords (0–1000 space)
  posX       Float            @default(500) @map("pos_x")
  posY       Float            @default(500) @map("pos_y")
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt      @map("updated_at")

  edgesFrom  NeuralMapEdge[]  @relation("NeuralEdgeFrom")
  edgesTo    NeuralMapEdge[]  @relation("NeuralEdgeTo")

  @@unique([worldId, entityType, entityId])
  @@index([worldId])
  @@map("neural_map_nodes")
  @@schema("world")
}

model NeuralMapEdge {
  id         String        @id @default(uuid())
  worldId    String        @map("world_id")
  world      World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  fromNodeId String        @map("from_node_id")
  fromNode   NeuralMapNode @relation("NeuralEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String        @map("to_node_id")
  toNode     NeuralMapNode @relation("NeuralEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  label      String?
  notes      String?
  directed   Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt      @map("updated_at")

  @@index([worldId])
  @@map("neural_map_edges")
  @@schema("world")
}

// World lore / plot missions (not system play-session Quests).
// Faction/NPC associations live in factions.FactionQuest / NpcQuest (soft plotQuestId).
// System Quests link via PlotQuestQuest.
model PlotQuest {
  id          String          @id @default(uuid())
  worldId     String          @map("world_id")
  world       World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  description String?         // markdown lore
  status      PlotQuestStatus @default(DRAFT)
  // Absolute day on the world calendar (null = no deadline). Replaces Gregorian deadlineAt.
  deadlineDay Int?            @map("deadline_day")
  sortOrder   Int             @default(0) @map("sort_order")
  createdBy   String          @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt      @map("updated_at")

  linkedQuests PlotQuestQuest[]

  @@index([worldId])
  @@map("plot_quests")
  @@schema("world")
}

model PlotQuestQuest {
  id          String    @id @default(uuid())
  plotQuestId String    @map("plot_quest_id")
  plotQuest   PlotQuest @relation(fields: [plotQuestId], references: [id], onDelete: Cascade)
  // quests.Quest — soft ID (cross-schema)
  questId     String    @map("quest_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([plotQuestId, questId])
  @@index([questId])
  @@map("plot_quest_quests")
  @@schema("world")
}
