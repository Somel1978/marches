/* shared/database/prisma/dnd5e.prisma */

// ── Skill system enums ────────────────────────────────────────────────────────

enum Dnd5eSkillName {
  ACROBATICS      // DEX
  ANIMAL_HANDLING // WIS
  ARCANA          // INT
  ATHLETICS       // STR
  DECEPTION       // CHA
  HISTORY         // INT
  INSIGHT         // WIS
  INTIMIDATION    // CHA
  INVESTIGATION   // INT
  MEDICINE        // WIS
  NATURE          // INT
  PERCEPTION      // WIS
  PERFORMANCE     // CHA
  PERSUASION      // CHA
  RELIGION        // INT
  SLEIGHT_OF_HAND // DEX
  STEALTH         // DEX
  SURVIVAL        // WIS

  @@schema("dnd5e")
}


model Dnd5eClass {
  id                   String   @id @default(uuid())
  gameSystemId         String   @map("game_system_id")
  name                 String
  description          String?
  source               String?
  link                 String?
  isAvailable          Boolean  @default(true)  @map("is_available")
  sortOrder            Int      @default(0)      @map("sort_order")
  hitDice              Int?                      @map("hit_dice")           // e.g. 8 for d8
  canCastSpells        Boolean  @default(false)  @map("can_cast_spells")
  primaryAbilities     String?                   @map("primary_abilities")  // e.g. "Strength, Constitution"
  equipmentDescription String?                   @map("equipment_description")
  subclassAvailableAtLevel Int  @default(3)      @map("subclass_available_at_level")
  skillChoiceCount         Int? @map("skill_choice_count")  // how many skills player picks at level 1
  createdAt            DateTime @default(now())  @map("created_at")
  updatedAt            DateTime @updatedAt       @map("updated_at")

  features      Dnd5eClassFeature[]
  subclasses    Dnd5eSubclass[]
  savingThrows  Dnd5eClassSavingThrow[]
  skillOptions  Dnd5eClassSkillOption[]

  @@unique([gameSystemId, name])
  @@map("classes")
  @@schema("dnd5e")
}

model Dnd5eClassFeature {
  id             String     @id @default(uuid())
  classId        String     @map("class_id")
  class          Dnd5eClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  requiredLevel       Int        @map("required_level")
  url                 String?
  grantsSkills        String?    @map("grants_skills")         // comma-sep e.g. "PERCEPTION,INSIGHT"
  grantsExpertise     String?    @map("grants_expertise")      // comma-sep e.g. "ARCANA"
  grantsHalfSkills    String?    @map("grants_half_skills")    // comma-sep e.g. "*" = all skills (Jack of All Trades)
  grantsSavingThrows  String?    @map("grants_saving_throws")  // comma-sep e.g. "STRENGTH,CONSTITUTION"
  skillChoiceCount  Int?     @map("skill_choice_count")  // how many the player picks
  skillChoicePool   String?  @map("skill_choice_pool")   // comma-sep pool; null = no choice
  savingThrowChoiceCount  Int?     @map("saving_throw_choice_count")
  savingThrowChoicePool   String?  @map("saving_throw_choice_pool")
  // Tool & Language grants
  grantsTools          String?  @map("grants_tools")
  toolChoiceCount      Int?     @map("tool_choice_count")
  toolChoicePool       String?  @map("tool_choice_pool")
  grantsLanguages      String?  @map("grants_languages")
  languageChoiceCount  Int?     @map("language_choice_count")
  languageChoicePool   String?  @map("language_choice_pool")
  // Damage modifier grants
  grantsResistances     String?  @map("grants_resistances")
  grantsImmunities      String?  @map("grants_immunities")
  grantsVulnerabilities String?  @map("grants_vulnerabilities")
  grantsInnateSpells    String?  @map("grants_innate_spells")  // "SpellName:usesPerDay,..." 0=at-will
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt      @map("updated_at")

  @@unique([classId, name, requiredLevel])
  @@map("class_features")
  @@schema("dnd5e")
}

model Dnd5eSubclass {
  id           String     @id @default(uuid())
  classId      String     @map("class_id")
  class        Dnd5eClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  source       String?
  link         String?
  isAvailable  Boolean    @default(true)  @map("is_available")
  canCastSpells Boolean   @default(false) @map("can_cast_spells")
  sortOrder    Int        @default(0)     @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt      @map("updated_at")

  features Dnd5eSubclassFeature[]

  @@unique([classId, name])
  @@map("subclasses")
  @@schema("dnd5e")
}

model Dnd5eSubclassFeature {
  id            String        @id @default(uuid())
  subclassId    String        @map("subclass_id")
  subclass      Dnd5eSubclass @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  requiredLevel       Int           @map("required_level")
  url                 String?
  grantsSkills        String?       @map("grants_skills")
  grantsExpertise     String?       @map("grants_expertise")
  grantsHalfSkills    String?       @map("grants_half_skills")
  grantsSavingThrows  String?       @map("grants_saving_throws")
  skillChoiceCount  Int?     @map("skill_choice_count")  // how many the player picks
  skillChoicePool   String?  @map("skill_choice_pool")   // comma-sep pool; null = no choice
  savingThrowChoiceCount  Int?     @map("saving_throw_choice_count")
  savingThrowChoicePool   String?  @map("saving_throw_choice_pool")
  // Tool & Language grants
  grantsTools          String?  @map("grants_tools")
  toolChoiceCount      Int?     @map("tool_choice_count")
  toolChoicePool       String?  @map("tool_choice_pool")
  grantsLanguages      String?  @map("grants_languages")
  languageChoiceCount  Int?     @map("language_choice_count")
  languageChoicePool   String?  @map("language_choice_pool")
  // Damage modifier grants
  grantsResistances     String?  @map("grants_resistances")
  grantsImmunities      String?  @map("grants_immunities")
  grantsVulnerabilities String?  @map("grants_vulnerabilities")
  grantsInnateSpells    String?  @map("grants_innate_spells")  // "SpellName:usesPerDay,..." 0=at-will
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt      @map("updated_at")

  @@unique([subclassId, name, requiredLevel])
  @@map("subclass_features")
  @@schema("dnd5e")
}

model Dnd5eSpecies {
  id           String   @id @default(uuid())
  gameSystemId String   @map("game_system_id")
  name         String
  description  String?
  source       String?
  link         String?
  isAvailable  Boolean  @default(true)  @map("is_available")
  isSubrace    Boolean  @default(false) @map("is_subrace")
  isLegacy     Boolean  @default(false) @map("is_legacy")
  sortOrder    Int      @default(0)     @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  traits  Dnd5eSpeciesTrait[]

  @@unique([gameSystemId, name])
  @@map("species")
  @@schema("dnd5e")
}

model Dnd5eSpeciesTrait {
  id            String       @id @default(uuid())
  speciesId     String       @map("species_id")
  species       Dnd5eSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  grantsSkills      String?  @map("grants_skills")      // comma-sep e.g. "PERCEPTION,INSIGHT"
  grantsExpertise   String?  @map("grants_expertise")   // comma-sep
  grantsHalfSkills  String?  @map("grants_half_skills") // comma-sep
  skillChoiceCount  Int?     @map("skill_choice_count")
  skillChoicePool   String?  @map("skill_choice_pool")
  savingThrowChoiceCount  Int?     @map("saving_throw_choice_count")
  savingThrowChoicePool   String?  @map("saving_throw_choice_pool")
  // Tool & Language grants
  grantsTools          String?  @map("grants_tools")           // comma-sep fixed tool grants
  toolChoiceCount      Int?     @map("tool_choice_count")
  toolChoicePool       String?  @map("tool_choice_pool")
  grantsLanguages      String?  @map("grants_languages")       // comma-sep fixed language grants
  languageChoiceCount  Int?     @map("language_choice_count")
  languageChoicePool   String?  @map("language_choice_pool")
  // Damage modifier grants
  grantsResistances     String?  @map("grants_resistances")    // comma-sep damage types
  grantsImmunities      String?  @map("grants_immunities")     // comma-sep damage types
  grantsVulnerabilities String?  @map("grants_vulnerabilities") // comma-sep damage types
  grantsInnateSpells    String?  @map("grants_innate_spells")  // "SpellName:minCharLevel:usesPerDay" 0=at-will
  // Physical characteristics granted by this trait
  size         String?  @map("size")          // fixed size e.g. "Medium"
  sizeChoices  String?  @map("size_choices")  // comma-sep pool if player picks e.g. "Small,Medium"
  senses       String?  @map("senses")        // free text e.g. "Darkvision 60 ft, Tremorsense 30 ft"
  requiredLevel     Int?     @map("required_level")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt      @map("updated_at")

  speeds  Dnd5eSpeciesTraitSpeed[]

  @@unique([speciesId, name])
  @@map("species_traits")
  @@schema("dnd5e")
}

model Dnd5eSpeciesTraitSpeed {
  id           String            @id @default(uuid())
  traitId      String            @map("trait_id")
  trait        Dnd5eSpeciesTrait @relation(fields: [traitId], references: [id], onDelete: Cascade)
  movementType String            @map("movement_type") // "WALK"|"FLY"|"SWIM"|"CLIMB"|"BURROW"
  speed        Int                                     // additive — two traits can both grant WALK speed
  createdAt    DateTime          @default(now())       @map("created_at")

  @@index([traitId])
  @@map("species_trait_speeds")
  @@schema("dnd5e")
}

model Dnd5eBackground {
  id                  String   @id @default(uuid())
  gameSystemId        String   @map("game_system_id")
  name                String
  shortDescription    String?  @map("short_description")
  featureName         String?  @map("feature_name")
  grantsFeatCategory  String?  @map("grants_feat_category")  // player picks any feat of this category
  grantsFeatId        String?  @map("grants_feat_id")          // background auto-grants this specific feat
  grantsFeat          Dnd5eFeat? @relation("BackgroundGrantedFeat", fields: [grantsFeatId], references: [id], onDelete: SetNull)
  toolProficiencies   String?  @map("tool_proficiencies")
  languages           String?
  url                 String?
  isAvailable         Boolean  @default(true) @map("is_available")
  sortOrder           Int      @default(0)    @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  grantsSkills      String?  @map("grants_skills")
  skillChoiceCount  Int?     @map("skill_choice_count")
  skillChoicePool   String?  @map("skill_choice_pool")
  savingThrowChoiceCount  Int?     @map("saving_throw_choice_count")
  savingThrowChoicePool   String?  @map("saving_throw_choice_pool")
  // Tool grants (replaces plain toolProficiencies string — kept for back-compat read)
  grantsTools          String?  @map("grants_tools")
  toolChoiceCount      Int?     @map("tool_choice_count")
  toolChoicePool       String?  @map("tool_choice_pool")
  // Language grants (replaces plain languages string — kept for back-compat read)
  grantsLanguages      String?  @map("grants_languages")
  languageChoiceCount  Int?     @map("language_choice_count")
  languageChoicePool   String?  @map("language_choice_pool")
  // Damage modifier grants
  grantsResistances     String?  @map("grants_resistances")
  grantsImmunities      String?  @map("grants_immunities")
  grantsVulnerabilities String?  @map("grants_vulnerabilities")
  grantsInnateSpells    String?  @map("grants_innate_spells")  // "SpellName:usesPerDay,..." 0=at-will

  @@unique([gameSystemId, name])
  @@map("backgrounds")
  @@schema("dnd5e")
}

model Dnd5eCharacterSheet {
  id             String    @id @default(uuid())
  characterId    String    @unique @map("character_id")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  speciesId      String?   @map("species_id")
  backgroundId   String?   @map("background_id")
  pendingChanges Json?     @map("pending_changes")
  size           String?   @map("size")  // chosen/overridden size (from trait sizeChoices pool or DM override)

  // Character details
  alignment         String?  @map("alignment")           // e.g. "Lawful Good"
  personalityTraits String?  @map("personality_traits")  // max 500 chars
  ideals            String?  @map("ideals")              // max 300 chars
  bonds             String?  @map("bonds")               // max 300 chars
  flaws             String?  @map("flaws")               // max 300 chars
  appearance        String?  @map("appearance")          // physical description, max 500 chars
  age               Int?     @map("age")
  height            String?  @map("height")              // e.g. "5'10\"" or "178 cm"
  weight            String?  @map("weight")              // e.g. "170 lbs"

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt      @map("updated_at")

  @@map("character_sheets")
  @@schema("dnd5e")
}

model Dnd5eCharacterClass {
  id             String    @id @default(uuid())
  characterId    String    @map("character_id")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  classId        String    @map("class_id")
  subclassId     String?   @map("subclass_id")
  allocatedLevel Int       @default(1) @map("allocated_level")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt      @map("updated_at")

  @@unique([characterId, classId])
  @@map("character_classes")
  @@schema("dnd5e")
}

model Dnd5eFeat {
  id            String   @id @default(uuid())
  gameSystemId  String   @map("game_system_id")
  name          String
  description   String?
  snippet       String?
  repeatable    Boolean  @default(false)
  categories    String?
  prerequisites String?
  detailsUrl    String?  @map("details_url")
  isAvailable   Boolean  @default(true)  @map("is_available")
  isEpicBoon    Boolean  @default(false) @map("is_epic_boon")
  asiAmount     Int?     @map("asi_amount")       // null = no grant; 1 = +1; 2 = +2
  asiStatFixed  String?  @map("asi_stat_fixed")   // e.g. "CONSTITUTION" — null means player picks
  asiStatChoices String? @map("asi_stat_choices") // comma-sep subset e.g. "STRENGTH,DEXTERITY"; null = any stat
  grantsSkills        String?  @map("grants_skills")         // comma-sep proficiency grants
  grantsExpertise     String?  @map("grants_expertise")      // comma-sep expertise grants
  grantsHalfSkills    String?  @map("grants_half_skills")    // comma-sep half proficiency grants
  grantsSavingThrows  String?  @map("grants_saving_throws")  // comma-sep saving throw grants
  skillChoiceCount  Int?     @map("skill_choice_count")  // how many the player picks
  skillChoicePool   String?  @map("skill_choice_pool")   // comma-sep pool; null = no choice
  savingThrowChoiceCount  Int?     @map("saving_throw_choice_count")
  savingThrowChoicePool   String?  @map("saving_throw_choice_pool")
  // Tool & Language grants
  grantsTools          String?  @map("grants_tools")
  toolChoiceCount      Int?     @map("tool_choice_count")
  toolChoicePool       String?  @map("tool_choice_pool")
  grantsLanguages      String?  @map("grants_languages")
  languageChoiceCount  Int?     @map("language_choice_count")
  languageChoicePool   String?  @map("language_choice_pool")
  // Damage modifier grants
  grantsResistances     String?  @map("grants_resistances")
  grantsImmunities      String?  @map("grants_immunities")
  grantsVulnerabilities String?  @map("grants_vulnerabilities")
  grantsInnateSpells    String?  @map("grants_innate_spells")  // "SpellName:usesPerDay,..." 0=at-will
  sortOrder     Int      @default(0)     @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  characterFeats       Dnd5eCharacterFeat[]
  grantedByBackgrounds Dnd5eBackground[]     @relation("BackgroundGrantedFeat")

  @@unique([gameSystemId, name])
  @@map("feats")
  @@schema("dnd5e")
}

model Dnd5eCharacterFeat {
  id            String    @id @default(uuid())
  characterId   String    @map("character_id")
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  featId        String    @map("feat_id")
  feat          Dnd5eFeat @relation(fields: [featId], references: [id], onDelete: Cascade)
  sourceClassId String?   @map("source_class_id")
  sourceLevel   Int?      @map("source_level")
  asiStat1      String?   @map("asi_stat1")
  asiAmount1    Int?      @map("asi_amount1")
  asiStat2      String?   @map("asi_stat2")
  asiAmount2    Int?      @map("asi_amount2")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("character_feats")
  @@schema("dnd5e")
}

// ── Spell System ─────────────────────────────────────────────────────────────

model Dnd5eSpell {
  id                       Int     @id @default(autoincrement())
  gameSystemId             String  @map("game_system_id")
  spellId                  Int     @map("spell_id")        // DDB definition ID
  name                     String
  link                     String?
  level                    Int                             // 0 = cantrip
  school                   String
  concentration            Boolean @default(false)
  ritual                   Boolean @default(false)
  isHomebrew               Boolean @default(false)        @map("is_homebrew")
  isLegacy                 Boolean @default(false)        @map("is_legacy")
  cantripDamage            String? @map("cantrip_damage")
  cantripDamageLvl5        String? @map("cantrip_damage_lvl5")
  cantripDamageLvl11       String? @map("cantrip_damage_lvl11")
  cantripDamageLvl17       String? @map("cantrip_damage_lvl17")
  spellDamage              String? @map("spell_damage")
  spellUpcastPerSlot       String? @map("spell_upcast_per_slot")
  spellUpcastEveryTwoSlots String? @map("spell_upcast_every_two_slots")
  spellProgression         String? @map("spell_progression")
  spellProgressionNote     String? @map("spell_progression_note")
  rangeOrigin              String? @map("range_origin")
  rangeValue               Int?    @map("range_value")
  aoeType                  String? @map("aoe_type")
  aoeValue                 Int?    @map("aoe_value")
  durationType             String? @map("duration_type")
  durationInterval         Int?    @map("duration_interval")
  durationUnit             String? @map("duration_unit")
  requiresSavingThrow      Boolean @default(false) @map("requires_saving_throw")
  savingThrow       String? @map("saving_throw") // e.g. "Wisdom", "Constitution"
  requiresAttackRoll       Boolean @default(false) @map("requires_attack_roll")
  canCastAtHigherLevel     Boolean @default(false) @map("can_cast_at_higher_level")
  castingTime              String? @map("casting_time")   // e.g. "Action", "Bonus Action", "Reaction", "1 Minute"
  components               String? @map("components")     // e.g. "V, S" or "V, S, M" or "V, S, M (material)"
  description              String? @map("description")    // full spell text, nullable
  sourceBook               String? @map("source_book")    // e.g. "Player's Handbook", "Xanathar's Guide"
  tags                     String?
  spellList                String? @map("spell_list") // comma-separated class names
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt      @map("updated_at")

  @@unique([gameSystemId, spellId])
  @@index([gameSystemId, level])
  @@index([gameSystemId, school])
  @@index([gameSystemId, concentration])
  @@index([gameSystemId, ritual])
  @@index([gameSystemId, isLegacy])
  @@map("spells")
  @@schema("dnd5e")
}

model Dnd5eSpellSlotProgression {
  id            String @id @default(uuid())
  gameSystemId  String @map("game_system_id")
  classId       String @map("class_id")
  className     String @map("class_name")      // denormalized
  subclassId    String @default("") @map("subclass_id")    // "" = class-level caster
  subclassName  String @default("") @map("subclass_name")  // denormalized
  casterType    String @map("caster_type")     // FULL | HALF | THIRD | PACT
  classLevel    Int    @map("class_level")     // 1–20
  slot1         Int    @default(0) @map("slot1")
  slot2         Int    @default(0) @map("slot2")
  slot3         Int    @default(0) @map("slot3")
  slot4         Int    @default(0) @map("slot4")
  slot5         Int    @default(0) @map("slot5")
  slot6         Int    @default(0) @map("slot6")
  slot7         Int    @default(0) @map("slot7")
  slot8         Int    @default(0) @map("slot8")
  slot9         Int    @default(0) @map("slot9")

  @@unique([gameSystemId, classId, subclassId, classLevel])
  @@map("spell_slot_progressions")
  @@schema("dnd5e")
}

model Dnd5eSpellsKnownProgression {
  id            String  @id @default(uuid())
  gameSystemId  String  @map("game_system_id")
  classId       String  @map("class_id")
  className     String  @map("class_name")     // denormalized
  subclassId    String  @default("") @map("subclass_id")   // "" = class-level caster
  subclassName  String  @default("") @map("subclass_name") // denormalized
  classLevel    Int     @map("class_level")    // 1–20
  cantrips      Int?                           // null = class has no cantrips
  prepared      Int?                           // null = formula-based, show note
  additional    Int?                           // bonus spells
  note          String?                        // e.g. "WIS mod + Cleric level"

  @@unique([gameSystemId, classId, subclassId, classLevel])
  @@map("spells_known_progressions")
  @@schema("dnd5e")
}

model Dnd5eSpellbook {
  id          String                @id @default(uuid())
  characterId String                @map("character_id")
  character   Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String                @default("Spellbook")
  isInnate    Boolean               @default(false) @map("is_innate") // true = innate spellcasting spellbook
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt      @map("updated_at")
  entries     Dnd5eSpellbookEntry[]

  @@map("spellbooks")
  @@schema("dnd5e")
}

model Dnd5eSpellbookEntry {
  id          String         @id @default(uuid())
  spellbookId String         @map("spellbook_id")
  spellbook   Dnd5eSpellbook @relation(fields: [spellbookId], references: [id], onDelete: Cascade)
  spellId     Int            @map("spell_id")      // references Dnd5eSpell.spellId
  classId     String?        @map("class_id")      // null for innate spellcasting entries
  className   String?        @map("class_name")    // denormalized; null for innate
  prepared    Boolean        @default(false)
  // Innate spellcasting fields (only relevant when spellbook.isInnate = true)
  usesPerDay       Int?     @map("uses_per_day")      // null = at will
  canUseSpellSlots Boolean  @default(false) @map("can_use_spell_slots")
  minCharLevel     Int?     @map("min_char_level")    // character level required to have this spell
  sourceType  String?  @map("source_type")   // "SpeciesTrait"|"ClassFeature"|"Feat"|"Background" etc.
  sourceId    String?  @map("source_id")     // UUID of granting entity — deletion key
  createdAt   DateTime       @default(now()) @map("created_at")

  // No unique constraint — one row per grant per source (same spell from two sources = two rows)
  @@index([spellbookId])
  @@index([spellbookId, sourceId])  // for efficient delete-by-source
  @@map("spellbook_entries")
  @@schema("dnd5e")
}

enum Dnd5eAbilityStat {
  STRENGTH
  DEXTERITY
  CONSTITUTION
  INTELLIGENCE
  WISDOM
  CHARISMA

  @@schema("dnd5e")
}

model Dnd5eAbilityScore {
  id          String           @id @default(uuid())
  characterId String           @map("character_id")
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  stat        Dnd5eAbilityStat
  baseScore   Int              @map("base_score")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt      @map("updated_at")

  @@unique([characterId, stat])
  @@map("ability_scores")
  @@schema("dnd5e")
}

enum ScoreEntrySource {
  INITIAL  // base scores set by player (point buy / rolled / standard array)
  ASI      // standard Ability Score Improvement feat (+2 or +1/+1)
  FEAT     // feat-granted ASI (Athlete, Resilient, etc.)
  MANUAL   // DM manual adjustment

  @@schema("dnd5e")
}

model Dnd5eScoreAuditEntry {
  id          String           @id @default(uuid())
  characterId String           @map("character_id")
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  stat        Dnd5eAbilityStat
  delta       Int              // positive = increase, negative = decrease
  source      ScoreEntrySource
  note        String?          // human-readable: "Athlete feat added", "War Caster removed, Resilient added"
  sourceId    String?          @map("source_id")   // charFeatId for programmatic linking
  actorId     String?          @map("actor_id")    // userId who made the change
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("score_audit_entries")
  @@schema("dnd5e")
}

// ── Skill system models ───────────────────────────────────────────────────────

model Dnd5eClassSavingThrow {
  id      String     @id @default(uuid())
  classId String     @map("class_id")
  class   Dnd5eClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  stat    String     // "STRENGTH" | "DEXTERITY" | "CONSTITUTION" | "INTELLIGENCE" | "WISDOM" | "CHARISMA"

  @@unique([classId, stat])
  @@map("class_saving_throws")
  @@schema("dnd5e")
}

model Dnd5eClassSkillOption {
  id      String         @id @default(uuid())
  classId String         @map("class_id")
  class   Dnd5eClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  skill   Dnd5eSkillName

  @@unique([classId, skill])
  @@map("class_skill_options")
  @@schema("dnd5e")
}

model Dnd5eCharacterSkillGrant {
  id          String         @id @default(uuid())
  characterId String         @map("character_id")
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill       Dnd5eSkillName
  value       Float          // 0.5 = half proficiency | 1.0 = proficient | 2.0 = expertise
  sourceType  String         @map("source_type")  // "Background"|"ClassFeature"|"SubclassFeature"|"SpeciesTrait"|"Feat"|"PlayerChoice"|"Player"|"DM"|"Admin"
  sourceId    String?        @map("source_id")    // id of granting entity — used for cleanup on removal
  note        String?                              // free-text reason for manual overrides (Player/DM/Admin)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([characterId])
  @@index([characterId, skill])
  @@map("character_skill_grants")
  @@schema("dnd5e")
}

model Dnd5eCharacterSavingThrowGrant {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  stat        String    // "STRENGTH" | "DEXTERITY" | "CONSTITUTION" | "INTELLIGENCE" | "WISDOM" | "CHARISMA"
  sourceType  String    @map("source_type")  // "Class"|"ClassFeature"|"SubclassFeature"|"Feat"|"Player"|"DM"|"Admin"
  sourceId    String?   @map("source_id")
  note        String?                          // free-text reason for manual overrides (Player/DM/Admin)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId])
  @@index([characterId, stat])
  @@map("character_saving_throw_grants")
  @@schema("dnd5e")
}

// ── Tool, Language & Damage Modifier grant tables ────────────────────────────
// Follow the same pattern as Dnd5eCharacterSkillGrant.
// sourceType: "Background"|"ClassFeature"|"SubclassFeature"|"SpeciesTrait"|"Feat"|"PlayerChoice"|"Override"
// Override rows: one per tool/language/type per character; note = who changed it and why.

model Dnd5eCharacterToolGrant {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tool        String                          // tool name e.g. "Thieves' Tools", "Smith's Tools"
  sourceType  String    @map("source_type")
  sourceId    String?   @map("source_id")
  note        String?                         // free-text reason for Override rows
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId])
  @@map("character_tool_grants")
  @@schema("dnd5e")
}

model Dnd5eCharacterLanguageGrant {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  language    String                          // language name e.g. "Common", "Elvish", "Dwarvish"
  sourceType  String    @map("source_type")
  sourceId    String?   @map("source_id")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId])
  @@map("character_language_grants")
  @@schema("dnd5e")
}

model Dnd5eCharacterDamageModifierGrant {
  id           String    @id @default(uuid())
  characterId  String    @map("character_id")
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  modifierType String    @map("modifier_type") // "RESISTANCE"|"IMMUNITY"|"VULNERABILITY"
  damageType   String    @map("damage_type")   // e.g. "Fire", "Necrotic", "Radiant", "Bludgeoning"
  sourceType   String    @map("source_type")
  sourceId     String?   @map("source_id")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([characterId])
  @@index([characterId, modifierType])
  @@map("character_damage_modifier_grants")
  @@schema("dnd5e")
}
