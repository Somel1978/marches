/* shared/database/prisma/dnd5e.prisma */

model Dnd5eClass {
  id                   String   @id @default(uuid())
  gameSystemId         String   @map("game_system_id")
  name                 String
  description          String?
  source               String?
  link                 String?
  isAvailable          Boolean  @default(true)  @map("is_available")
  sortOrder            Int      @default(0)      @map("sort_order")
  hitDice              Int?                      @map("hit_dice")           // e.g. 8 for d8
  canCastSpells        Boolean  @default(false)  @map("can_cast_spells")
  primaryAbilities     String?                   @map("primary_abilities")  // e.g. "Strength, Constitution"
  equipmentDescription String?                   @map("equipment_description")
  subclassAvailableAtLevel Int  @default(3)      @map("subclass_available_at_level")
  createdAt            DateTime @default(now())  @map("created_at")
  updatedAt            DateTime @updatedAt       @map("updated_at")

  features   Dnd5eClassFeature[]
  subclasses Dnd5eSubclass[]

  @@unique([gameSystemId, name])
  @@map("classes")
  @@schema("dnd5e")
}

model Dnd5eClassFeature {
  id             String     @id @default(uuid())
  classId        String     @map("class_id")
  class          Dnd5eClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  requiredLevel  Int        @map("required_level")
  url            String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt      @map("updated_at")

  @@unique([classId, name, requiredLevel])
  @@map("class_features")
  @@schema("dnd5e")
}

model Dnd5eSubclass {
  id           String     @id @default(uuid())
  classId      String     @map("class_id")
  class        Dnd5eClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  source       String?
  link         String?
  isAvailable  Boolean    @default(true) @map("is_available")
  sortOrder    Int        @default(0)    @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt      @map("updated_at")

  features Dnd5eSubclassFeature[]

  @@unique([classId, name])
  @@map("subclasses")
  @@schema("dnd5e")
}

model Dnd5eSubclassFeature {
  id            String        @id @default(uuid())
  subclassId    String        @map("subclass_id")
  subclass      Dnd5eSubclass @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  requiredLevel Int           @map("required_level")
  url           String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt      @map("updated_at")

  @@unique([subclassId, name, requiredLevel])
  @@map("subclass_features")
  @@schema("dnd5e")
}

model Dnd5eSpecies {
  id          String   @id @default(uuid())
  gameSystemId String  @map("game_system_id")
  name        String
  description String?
  source      String?
  link        String?
  isAvailable Boolean  @default(true)  @map("is_available")
  isSubrace   Boolean  @default(false) @map("is_subrace")
  isLegacy    Boolean  @default(false) @map("is_legacy")
  sortOrder   Int      @default(0)     @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  traits Dnd5eSpeciesTrait[]

  @@unique([gameSystemId, name])
  @@map("species")
  @@schema("dnd5e")
}

model Dnd5eSpeciesTrait {
  id            String       @id @default(uuid())
  speciesId     String       @map("species_id")
  species       Dnd5eSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  requiredLevel Int?         @map("required_level")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt      @map("updated_at")

  @@unique([speciesId, name])
  @@map("species_traits")
  @@schema("dnd5e")
}

model Dnd5eBackground {
  id                  String   @id @default(uuid())
  gameSystemId        String   @map("game_system_id")
  name                String
  shortDescription    String?  @map("short_description")
  featureName         String?  @map("feature_name")
  grantsFeatCategory  String?  @map("grants_feat_category")  // player picks any feat of this category
  grantsFeatId        String?  @map("grants_feat_id")          // background auto-grants this specific feat
  grantsFeat          Dnd5eFeat? @relation("BackgroundGrantedFeat", fields: [grantsFeatId], references: [id], onDelete: SetNull)
  skillProficiencies  String?  @map("skill_proficiencies")
  toolProficiencies   String?  @map("tool_proficiencies")
  languages           String?
  url                 String?
  isAvailable         Boolean  @default(true) @map("is_available")
  sortOrder           Int      @default(0)    @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  @@unique([gameSystemId, name])
  @@map("backgrounds")
  @@schema("dnd5e")
}

model Dnd5eCharacterSheet {
  id             String    @id @default(uuid())
  characterId    String    @unique @map("character_id")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  speciesId      String?   @map("species_id")
  backgroundId   String?   @map("background_id")
  pendingChanges Json?     @map("pending_changes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt      @map("updated_at")

  @@map("character_sheets")
  @@schema("dnd5e")
}

model Dnd5eCharacterClass {
  id             String    @id @default(uuid())
  characterId    String    @map("character_id")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  classId        String    @map("class_id")
  subclassId     String?   @map("subclass_id")
  allocatedLevel Int       @default(1) @map("allocated_level")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt      @map("updated_at")

  @@unique([characterId, classId])
  @@map("character_classes")
  @@schema("dnd5e")
}

model Dnd5eFeat {
  id            String   @id @default(uuid())
  gameSystemId  String   @map("game_system_id")
  name          String
  description   String?
  snippet       String?
  repeatable    Boolean  @default(false)
  categories    String?
  prerequisites String?
  detailsUrl    String?  @map("details_url")
  isAvailable   Boolean  @default(true)  @map("is_available")
  isEpicBoon    Boolean  @default(false) @map("is_epic_boon")
  asiAmount     Int?     @map("asi_amount")       // null = no grant; 1 = +1; 2 = +2
  asiStatFixed  String?  @map("asi_stat_fixed")   // e.g. "CONSTITUTION" — null means player picks
  asiStatChoices String? @map("asi_stat_choices") // comma-sep subset e.g. "STRENGTH,DEXTERITY"; null = any stat
  sortOrder     Int      @default(0)     @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  characterFeats       Dnd5eCharacterFeat[]
  grantedByBackgrounds Dnd5eBackground[]     @relation("BackgroundGrantedFeat")

  @@unique([gameSystemId, name])
  @@map("feats")
  @@schema("dnd5e")
}

model Dnd5eCharacterFeat {
  id            String    @id @default(uuid())
  characterId   String    @map("character_id")
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  featId        String    @map("feat_id")
  feat          Dnd5eFeat @relation(fields: [featId], references: [id], onDelete: Cascade)
  sourceClassId String?   @map("source_class_id")
  sourceLevel   Int?      @map("source_level")
  asiStat1      String?   @map("asi_stat1")
  asiAmount1    Int?      @map("asi_amount1")
  asiStat2      String?   @map("asi_stat2")
  asiAmount2    Int?      @map("asi_amount2")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("character_feats")
  @@schema("dnd5e")
}

// ── Spell System ─────────────────────────────────────────────────────────────

model Dnd5eSpell {
  id                       Int     @id @default(autoincrement())
  gameSystemId             String  @map("game_system_id")
  spellId                  Int     @map("spell_id")        // DDB definition ID
  name                     String
  link                     String?
  level                    Int                             // 0 = cantrip
  school                   String
  concentration            Boolean @default(false)
  ritual                   Boolean @default(false)
  isHomebrew               Boolean @default(false)        @map("is_homebrew")
  isLegacy                 Boolean @default(false)        @map("is_legacy")
  cantripDamage            String? @map("cantrip_damage")
  cantripDamageLvl5        String? @map("cantrip_damage_lvl5")
  cantripDamageLvl11       String? @map("cantrip_damage_lvl11")
  cantripDamageLvl17       String? @map("cantrip_damage_lvl17")
  spellDamage              String? @map("spell_damage")
  spellUpcastPerSlot       String? @map("spell_upcast_per_slot")
  spellUpcastEveryTwoSlots String? @map("spell_upcast_every_two_slots")
  spellProgression         String? @map("spell_progression")
  spellProgressionNote     String? @map("spell_progression_note")
  rangeOrigin              String? @map("range_origin")
  rangeValue               Int?    @map("range_value")
  aoeType                  String? @map("aoe_type")
  aoeValue                 Int?    @map("aoe_value")
  durationType             String? @map("duration_type")
  durationInterval         Int?    @map("duration_interval")
  durationUnit             String? @map("duration_unit")
  requiresSavingThrow      Boolean @default(false) @map("requires_saving_throw")
  requiresAttackRoll       Boolean @default(false) @map("requires_attack_roll")
  canCastAtHigherLevel     Boolean @default(false) @map("can_cast_at_higher_level")
  tags                     String?
  spellList                String? @map("spell_list") // comma-separated class names
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt      @map("updated_at")

  @@unique([gameSystemId, spellId])
  @@index([gameSystemId, level])
  @@index([gameSystemId, school])
  @@index([gameSystemId, concentration])
  @@index([gameSystemId, ritual])
  @@index([gameSystemId, isLegacy])
  @@map("spells")
  @@schema("dnd5e")
}

model Dnd5eSpellSlotProgression {
  id           String @id @default(uuid())
  gameSystemId String @map("game_system_id")
  classId      String @map("class_id")
  className    String @map("class_name")   // denormalized
  casterType   String @map("caster_type")  // FULL | HALF | THIRD | PACT
  classLevel   Int    @map("class_level")  // 1–20
  slot1        Int    @default(0) @map("slot1")
  slot2        Int    @default(0) @map("slot2")
  slot3        Int    @default(0) @map("slot3")
  slot4        Int    @default(0) @map("slot4")
  slot5        Int    @default(0) @map("slot5")
  slot6        Int    @default(0) @map("slot6")
  slot7        Int    @default(0) @map("slot7")
  slot8        Int    @default(0) @map("slot8")
  slot9        Int    @default(0) @map("slot9")

  @@unique([gameSystemId, classId, classLevel])
  @@map("spell_slot_progressions")
  @@schema("dnd5e")
}

model Dnd5eSpellsKnownProgression {
  id           String  @id @default(uuid())
  gameSystemId String  @map("game_system_id")
  classId      String  @map("class_id")
  className    String  @map("class_name")  // denormalized
  classLevel   Int     @map("class_level") // 1–20
  cantrips     Int?                        // null = class has no cantrips
  prepared     Int?                        // null = formula-based, show note
  additional   Int?                        // bonus spells
  note         String?                     // e.g. "WIS mod + Cleric level"

  @@unique([gameSystemId, classId, classLevel])
  @@map("spells_known_progressions")
  @@schema("dnd5e")
}

model Dnd5eSpellbook {
  id          String                @id @default(uuid())
  characterId String                @map("character_id")
  character   Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String                @default("Spellbook")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt      @map("updated_at")
  entries     Dnd5eSpellbookEntry[]

  @@map("spellbooks")
  @@schema("dnd5e")
}

model Dnd5eSpellbookEntry {
  id          String         @id @default(uuid())
  spellbookId String         @map("spellbook_id")
  spellbook   Dnd5eSpellbook @relation(fields: [spellbookId], references: [id], onDelete: Cascade)
  spellId     Int            @map("spell_id")   // references Dnd5eSpell.spellId
  classId     String         @map("class_id")
  className   String         @map("class_name") // denormalized
  prepared    Boolean        @default(false)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([spellbookId, spellId, classId])
  @@map("spellbook_entries")
  @@schema("dnd5e")
}

enum Dnd5eAbilityStat {
  STRENGTH
  DEXTERITY
  CONSTITUTION
  INTELLIGENCE
  WISDOM
  CHARISMA

  @@schema("dnd5e")
}

model Dnd5eAbilityScore {
  id          String           @id @default(uuid())
  characterId String           @map("character_id")
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  stat        Dnd5eAbilityStat
  baseScore   Int              @map("base_score")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt      @map("updated_at")

  @@unique([characterId, stat])
  @@map("ability_scores")
  @@schema("dnd5e")
}

enum ScoreEntrySource {
  INITIAL  // base scores set by player (point buy / rolled / standard array)
  ASI      // standard Ability Score Improvement feat (+2 or +1/+1)
  FEAT     // feat-granted ASI (Athlete, Resilient, etc.)
  MANUAL   // DM manual adjustment

  @@schema("dnd5e")
}

model Dnd5eScoreAuditEntry {
  id          String           @id @default(uuid())
  characterId String           @map("character_id")
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  stat        Dnd5eAbilityStat
  delta       Int              // positive = increase, negative = decrease
  source      ScoreEntrySource
  note        String?          // human-readable: "Athlete feat added", "War Caster removed, Resilient added"
  sourceId    String?          @map("source_id")   // charFeatId for programmatic linking
  actorId     String?          @map("actor_id")    // userId who made the change
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("score_audit_entries")
  @@schema("dnd5e")
}
