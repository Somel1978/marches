{
  "name": "@core/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:seed": "dotenv -e ../../.env -- tsx seed.ts",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- bash -c 'prisma studio --browser none --port 5555'",
    "check:dnd5e-sync": "tsx scripts/check-dnd5e-sync.ts"
  },
  "prisma": {
    "config": "prisma.config.ts"
  },
  "dependencies": {
    "@core/errors": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "~1.4.22",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "7.8.0"
  }
}