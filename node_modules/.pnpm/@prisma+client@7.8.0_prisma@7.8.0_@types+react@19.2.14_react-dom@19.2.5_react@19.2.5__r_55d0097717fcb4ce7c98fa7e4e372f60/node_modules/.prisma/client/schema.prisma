model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("users")
}

model Account {
  id         String @id @default(uuid())
  accountId  String @map("account_id")
  providerId String @map("provider_id")
  userId     String @map("user_id")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("accounts")
  @@schema("users")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
  @@schema("users")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "users"]
}

// ─── Domain Models ────────────────────────────────────────────────────────────
// All models live in the "users" Postgres schema.
// ─────────────────────────────────────────────────────────────────────────────

enum AccessLevel {
  NONE
  OWN
  ALL

  @@schema("users")
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  // Domain fields — also declared as additionalFields in @core/rbac createAuth()
  // so better-auth is aware of them. input: false means they are not settable
  // during signup; they must be updated via a profile endpoint.
  discordHandle String? @map("discord_handle")
  mobile        String?

  // NOTE: no password field here. better-auth stores the hashed password in
  // Account.password (see auth.prisma). Having a password on User would create
  // two sources of truth and cause confusion.

  // better-auth relations
  sessions Session[]
  accounts Account[]

  // RBAC — explicit join table (UserRole) instead of implicit M2M.
  // Implicit M2M with multiSchema has ambiguous join-table schema placement.
  // Explicit gives us control over schema, indices, and audit fields.
  userRoles UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@map("users")
  @@schema("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
  @@schema("users")
}

// Explicit join table for User <-> Role.
// Replaces the implicit M2M Prisma would have generated.
// Explicit gives us:
//   - guaranteed @@schema("users") placement
//   - assignedAt / assignedBy audit trail
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("users")
}

model RolePermission {
  id     String @id @default(uuid())
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  resource String

  canCreate AccessLevel @default(NONE) @map("can_create")
  canRead   AccessLevel @default(NONE) @map("can_read")
  canUpdate AccessLevel @default(NONE) @map("can_update")
  canDelete AccessLevel @default(NONE) @map("can_delete")

  @@unique([roleId, resource])
  @@map("role_permissions")
  @@schema("users")
}
