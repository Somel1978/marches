/**
 * shared/database/prisma/audit.prisma
 */

// Audit Log (schema: audit, order: 04)
// Append-only. Never update or delete rows.
// Records who did what to which resource, with before/after snapshots.
// Written inside dbapi transactions so audit entries are atomic with changes.
// 

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  REVOKE

  @@schema("audit")
}

model AuditLog {
  id String @id @default(uuid())

  // Who performed the action. Null for system/seed actions.
  actorId String? @map("actor_id")
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action AuditAction

  // What kind of entity was affected (matches platform.Resource.key)
  resourceKey String @map("resource_key")
  // Which specific entity
  resourceId  String @map("resource_id")

  // JSON snapshots. Null for creates (no before) or deletes (no after).
  before Json?
  after  Json?

  // Optional extra context (e.g. IP address, request ID)
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  // Indexed for common query patterns
  @@index([actorId])
  @@index([resourceKey, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("audit")
}

/**
 * shared/database/prisma/auth.prisma
 */

// ── Better-Auth Models (schema: auth, order: 03) ─────────────────────────────
// Owned by better-auth. FKs to users.User.
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("auth")
}

model Account {
  id         String @id @default(uuid())
  accountId  String @map("account_id")
  providerId String @map("provider_id")
  userId     String @map("user_id")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Required for upsert by accountId + providerId (e.g. password reset)
  @@unique([accountId, providerId])
  @@map("accounts")
  @@schema("auth")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
  @@schema("auth")
}

/**
 * shared/database/prisma/base.prisma
 */

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
  // Schema order — dependency chain, never reorder existing entries:
  // 01 platform  no dependencies, foundation for everything
  // 02 users     cross-schema FK from RolePermission → platform.Resource
  // 03 auth      FKs to users.User (better-auth owned)
  // 04 audit     FKs to users.User
  // 05+ features FK to platform.Resource.key
  schemas    = ["platform", "users", "auth", "audit"]
}

/**
 * shared/database/prisma/platform.prisma
 */

// ── Platform Registry (schema: platform, order: 01) ──────────────────────────

enum NavVisibility {
  NONE
  ANY
  ALL

  @@schema("platform")
}

model Module {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  resources   Resource[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("modules")
  @@schema("platform")
}

model Resource {
  id              String           @id @default(uuid())
  key             String           @unique
  displayName     String           @map("display_name")
  description     String?
  moduleId        String           @map("module_id")
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sortOrder       Int              @default(0) @map("sort_order")
  navVisibility   NavVisibility    @default(NONE) @map("nav_visibility")
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("resources")
  @@schema("platform")
}

// ── Runtime Settings ──────────────────────────────────────────────────────────
// Editable from the admin /settings page.
// isSecret=true values are masked in the UI.
// SMTP, email, and site config live here so they can be changed without
// redeploying or editing .env.
model Setting {
  key         String   @id // e.g. 'smtp.host', 'site.url'
  value       String? // null = unset / use default
  description String?
  isSecret    Boolean  @default(false) @map("is_secret")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("settings")
  @@schema("platform")
}

/**
 * shared/database/prisma/users.prisma
 */

// ── Domain Models (schema: users, order: 02) ─────────────────────────────────
// Cross-schema FK: RolePermission.resourceKey → platform.Resource.key
// auth schema models live in auth.prisma.
// ─────────────────────────────────────────────────────────────────────────────

enum AccessLevel {
  NONE
  OWN
  ALL

  @@schema("users")
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  discordHandle String? @map("discord_handle")
  mobile        String?

  sessions  Session[]
  accounts  Account[]
  userRoles UserRole[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // GIN trigram indexes for ILIKE search on name and email.
  // Enables PostgreSQL to use the pg_trgm index for contains/ILIKE queries
  // instead of a full table scan. Required for get-all.ts search to scale.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "users_name_trgm_idx", type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], map: "users_email_trgm_idx", type: Gin)
  @@map("users")
  @@schema("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
  @@schema("users")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("users")
}

model RolePermission {
  id     String @id @default(uuid())
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Cross-schema FK → platform.Resource.key
  resourceKey String   @map("resource_key")
  resource    Resource @relation(fields: [resourceKey], references: [key], onDelete: Cascade)

  canCreate AccessLevel @default(NONE) @map("can_create")
  canRead   AccessLevel @default(NONE) @map("can_read")
  canUpdate AccessLevel @default(NONE) @map("can_update")
  canDelete AccessLevel @default(NONE) @map("can_delete")

  @@unique([roleId, resourceKey])
  @@map("role_permissions")
  @@schema("users")
}
