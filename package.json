{
  "name": "Marches",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @core/database exec prisma generate",
    "build": "turbo build",
    "dev": "turbo dev --filter=@apps/frontend -- --host",
    "dev:frontend": "turbo dev --filter=@apps/frontend -- --host",
    "dev:admin": "turbo dev --filter=@apps/admin -- --host",
    "dev:all": "turbo dev --filter=@apps/* -- --host",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,js,svelte,json,md}\""
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.9"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "overrides": {
      "better-sqlite3": "npm:empty-npm-package"
    },
    "allowedDeprecatedVersions": {
      "prebuild-install": "7.1.3"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "tailwindcss",
        "vite",
        "postcss",
        "drizzle-orm"
      ],
      "allowedVersions": {
        "vite": "^8.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "tailwindcss": "^4.0.0",
        "drizzle-orm": "*"
      }
    }
  }
}